# =====================================================================
# Variáveis do Supabase
# ---------------------------------------------------------------------
# Copie este arquivo para .env (local) ou cadastre estas duas variáveis
# no painel da Vercel / Netlify. No build, scripts/build-config.mjs lê
# estes valores e gera assets/js/config.js.
#
# Onde encontrar: painel do Supabase > Project Settings > API
#
# ATENÇÃO: aqui só entra a chave ANON (pública). A chave service_role
# ignora o RLS e NUNCA pode aparecer no front-end nem neste arquivo.
# =====================================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
